# === Docker-specific environment configuration ===
#
# This file is used by docker-compose.yml (env_file: .env.docker).
# It contains settings that differ between Docker and local-dev environments —
# mainly the Postgres host name, which is the Docker service name "db" instead
# of "localhost".
#
# Usage:
#   cp env.docker.example .env.docker
# Then edit the values as needed (especially USER_AGENT).

# --- PostgreSQL ---
# These three variables are read by BOTH the "db" container (as initial DB
# credentials) AND the "backend"/"celeryworker" containers (to connect to it).
POSTGRES_DB=laserslicer
POSTGRES_USER=laserslicer
POSTGRES_PASSWORD=devpassword

# --- Django ---
# User Agent string required by the Nominatim/OSM usage policy.
# Change this to identify your instance.
USER_AGENT=laser-slicer/3.0 (change-me@example.com)

# Optional overrides (the defaults below match the docker-compose service names
# and are already set inline in docker-compose.yml, but you can override here):
# DJANGO_SECRET_KEY=change-me-in-production
# DJANGO_DEBUG=True
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
# DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:4173
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/0
